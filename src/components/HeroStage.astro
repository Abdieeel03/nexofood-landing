---
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
---

<section
  id="inicio"
  class="relative min-h-[100dvh] flex flex-col justify-center bg-inverse-surface text-inverse-on-surface pt-28 sm:pt-32 pb-16 sm:pb-20 overflow-hidden"
>
  {/* Warm Full-Bleed Hospitality Background Image Blended with Brand Palette */}
  <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
    <img
      src="/images/hero-hospitality-warm.jpg"
      alt=""
      width="1600"
      height="900"
      fetchpriority="high"
      decoding="async"
      class="w-full h-full object-cover object-center opacity-35 scale-[1.02] saturate-[1.08]"
    />
    {/* Deep Emerald-Charcoal + Warm Ambient Vignette for Contrast & Smooth Blending */}
    <div
      class="absolute inset-0 bg-gradient-to-b from-[#111915]/80 via-[#111915]/68 to-[#111915]/95"
    ></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_75%_55%_at_50%_22%,rgba(0,108,73,0.36),transparent_68%),radial-gradient(ellipse_60%_50%_at_50%_82%,rgba(254,106,52,0.18),transparent_70%)]"
    ></div>
  </div>

  <Container class="relative z-10 flex flex-col items-center text-center">
    {/* Centered Headline + Subheadline + Primary CTA */}
    <div class="max-w-[54rem] mx-auto flex flex-col items-center gap-6 sm:gap-7">
      <h1
        data-split="hero"
        class="type-display font-bold text-white drop-shadow-[0_2px_18px_rgba(11,17,14,0.45)]"
      >
        Tu negocio gastronómico va a{' '}
        <span class="font-editorial italic font-normal text-primary-fixed">
          vender más,
        </span>{' '}
        en más lugares y sin comisiones abusivas.
      </h1>

      <p
        data-hero-fade
        class="text-base sm:text-lg text-[#d6e6dc] max-w-[38rem] leading-relaxed"
      >
        Crea tu tienda online propia con pagos vía Mercado Pago desde 3.49%, sincroniza comandas en una sola pantalla de cocina y quédate con el 100% de los datos de tus comensales.
      </p>

      <div data-hero-fade class="pt-2">
        <a
          href="https://nexofood-app.com/register"
          class="eloq-btn min-h-[52px] px-7 sm:px-8 py-3.5 bg-secondary-container text-on-secondary text-sm sm:text-base font-bold shadow-cta"
        >
          <span class="eloq-btn-curtain bg-primary"></span>
          <span>Comenzar Prueba Gratuita</span>
          <span class="eloq-btn-arrows" aria-hidden="true">
            <Icon name="arrow_right" size={18} />
            <Icon name="arrow_right" size={18} />
          </span>
        </a>
      </div>
    </div>
  </Container>
</section>

<script>
  import { ensureGsapRegistered } from '../scripts/gsap-setup';

  function initHeroStage() {
    const { gsap, SplitText } = ensureGsapRegistered();

    // GSAP SplitText + Centered Hero Entrance (Respecting prefers-reduced-motion)
    const mm = gsap.matchMedia();
    mm.add(
      {
        canAnimate: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.canAnimate) return;

        const split = SplitText.create('[data-split="hero"]', {
          type: 'lines,words',
          mask: 'lines',
          autoSplit: true,
          onSplit(self) {
            return gsap.from(self.lines, {
              yPercent: 110,
              autoAlpha: 0,
              duration: 0.85,
              stagger: 0.1,
              ease: 'power4.out',
              clearProps: 'transform,opacity,visibility',
            });
          },
        });

        gsap.from('[data-hero-fade]', {
          y: 20,
          autoAlpha: 0,
          duration: 0.65,
          delay: 0.2,
          stagger: 0.09,
          ease: 'power3.out',
          clearProps: 'transform,opacity,visibility',
        });

        return () => {
          split?.revert();
        };
      }
    );

    return () => {
      mm.revert();
    };
  }

  let cleanupHero: (() => void) | undefined;
  const mount = () => {
    cleanupHero?.();
    cleanupHero = initHeroStage();
  };
  mount();
  document.addEventListener('astro:page-load', mount);
</script>
