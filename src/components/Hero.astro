---
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';
import { HeroEmailForm } from './react/HeroEmailForm';
---

<section
  class="relative min-h-auto lg:min-h-[52rem] flex items-center pt-22 sm:pt-28 lg:pt-34 pb-12 sm:pb-16 lg:pb-22 overflow-hidden bg-inverse-surface"
  id="inicio"
>
  {/* Atmospheric Dark Kitchen Surface */}
  <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_18%_20%,rgba(0,108,73,0.28),transparent_65%),radial-gradient(ellipse_60%_50%_at_85%_75%,rgba(254,106,52,0.14),transparent_65%)]"
    ></div>
    <div
      class="absolute inset-0 opacity-[0.04] bg-[linear-gradient(to_right,#ffffff_1px,transparent_1px),linear-gradient(to_bottom,#ffffff_1px,transparent_1px)] bg-[size:3.5rem_3.5rem]"
    ></div>
  </div>

  <Container>
    <div class="relative z-20 grid grid-cols-1 lg:grid-cols-[1.12fr_0.88fr] gap-8 sm:gap-10 lg:gap-12 items-center">
      {/* Left Column: Mobile-first Value Proposition */}
      <div class="flex flex-col gap-4 sm:gap-6 text-inverse-on-surface items-start text-left">
        <h1
          data-hero-reveal
          class="text-[2rem] leading-[1.12] sm:text-5xl lg:text-[3.35rem] font-extrabold tracking-[-0.03em] text-white sm:leading-[1.08] text-balance"
        >
          Tu negocio gastronómico va a{' '}
          <span class="font-editorial italic font-normal text-primary-fixed relative whitespace-nowrap inline-block">
            vender más,
            <svg
              class="absolute -bottom-1 sm:-bottom-1.5 left-0 w-full h-2 sm:h-2.5 text-primary-container/55 pointer-events-none"
              viewBox="0 0 100 10"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M0 6 Q 50 10 100 4"
                fill="none"
                stroke="currentColor"
                stroke-width="3.5"
                stroke-linecap="round"
              />
            </svg>
          </span>{' '}
          en más lugares y sin comisiones abusivas.
        </h1>

        <p
          data-hero-reveal
          class="text-[0.9375rem] sm:text-lg leading-relaxed text-[#d2e2d7] max-w-[36rem] text-pretty"
        >
          Crea tu tienda online propia al 0%, sincroniza comandas de Rappi, PedidosYa y WhatsApp en una sola pantalla de cocina, y quédate con el 100% de los datos de tus comensales.
        </p>

        <div data-hero-reveal class="w-full">
          <HeroEmailForm client:load />
        </div>

        {/* Operational Commitments: stacked cleanly on narrow mobile, inline on sm+ */}
        <div
          data-hero-reveal
          class="grid grid-cols-1 sm:flex sm:flex-wrap items-start sm:items-center gap-y-2 sm:gap-x-6 sm:gap-y-2.5 pt-1 text-[#c6d7cc] text-xs sm:text-sm font-semibold w-full"
        >
          <div class="flex items-center gap-2">
            <span class="text-primary-fixed flex shrink-0">
              <Icon name="check_circle" size={18} fill={true} />
            </span>
            <span>14 días de prueba sin tarjeta</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary-fixed flex shrink-0">
              <Icon name="check_circle" size={18} fill={true} />
            </span>
            <span>Sin contratos de permanencia</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="text-primary-fixed flex shrink-0">
              <Icon name="check_circle" size={18} fill={true} />
            </span>
            <span class="tabular-nums">Menú activo en 15 min</span>
          </div>
        </div>
      </div>

      {/* Right Column: Mobile-first Interactive KDS & Storefront Command Center */}
      <div
        data-hero-board
        class="relative w-full max-w-[34rem] mx-auto lg:max-w-none"
      >
        {/* Outer Shell: rounded-2xl p-2.5 on mobile, rounded-3xl p-3 on sm+ */}
        <div class="rounded-2xl sm:rounded-3xl p-2.5 sm:p-3 bg-[#18241e]/95 shadow-[0_0_0_1px_oklch(1_0_0/0.11),0_28px_60px_-12px_rgba(0,0,0,0.65)] backdrop-blur-md">
          {/* Top Bar: wraps cleanly on small phones */}
          <div class="flex flex-wrap items-center justify-between gap-2 px-3 py-2.5 rounded-xl bg-[#101814] shadow-[0_0_0_1px_oklch(1_0_0/0.07)] mb-2">
            <div class="flex items-center gap-2 min-w-0">
              <span class="relative flex h-2.5 w-2.5 shrink-0">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-fixed opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-primary-fixed"></span>
              </span>
              <span class="text-xs font-bold text-white tracking-tight truncate">
                KDS Cocina Central · En vivo
              </span>
            </div>
            <div class="flex items-center gap-1.5 text-[11px] font-semibold text-[#b4c8bc] tabular-nums shrink-0">
              <span class="px-2 py-0.5 rounded-md bg-primary/35 text-primary-fixed">
                Prom: <strong id="hero-kds-avg">14m 20s</strong>
              </span>
            </div>
          </div>

          {/* Interactive Order Tickets List */}
          <div class="flex flex-col gap-2" id="hero-kds-tickets">
            {/* Ticket 1: Direct Channel (0% Commission) */}
            <div
              class="t-acc t-resize rounded-xl bg-[#1f2e26] p-3 sm:p-3.5 shadow-[0_0_0_1px_oklch(1_0_0/0.09)] transition-[background-color,box-shadow] duration-150"
              data-open="true"
              data-ticket-card
            >
              <button
                type="button"
                class="t-acc-head w-full min-h-[44px] flex items-center justify-between gap-2 text-left cursor-pointer"
                aria-expanded="true"
                data-ticket-toggle
              >
                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 min-w-0">
                  <span class="px-2 py-0.5 rounded-md bg-primary-fixed text-on-primary-fixed text-[11px] font-extrabold tracking-tight tabular-nums shrink-0">
                    #NF-408
                  </span>
                  <span class="text-xs sm:text-sm font-bold text-white truncate">
                    Tienda Propia Web
                  </span>
                  <span class="text-[10px] sm:text-[11px] font-bold text-primary-fixed bg-primary/30 px-2 py-0.5 rounded-full tabular-nums shrink-0">
                    0% comisión
                  </span>
                </div>
                <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white shrink-0 pl-1">
                  <span class="tabular-nums">$42.80</span>
                  <span class="t-acc-chevron w-4 h-4 text-[#9db3a6]">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <path d="M4 6.5L8 10.5L12 6.5"></path>
                    </svg>
                  </span>
                </div>
              </button>

              <div class="t-acc-panel">
                <div class="t-acc-panel-inner">
                  <div class="pt-3 mt-2.5 border-t border-white/10 flex flex-col gap-2">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5 sm:gap-2 text-xs text-[#d6e5da] tabular-nums">
                      <span>2× Smash Burger Trufa Doble + Papas</span>
                      <span class="font-semibold text-primary-fixed sm:text-white">Estación Plancha</span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5 sm:gap-2 text-xs text-[#d6e5da] tabular-nums">
                      <span>1× Limonada de Hierbabuena 500ml</span>
                      <span class="font-semibold text-primary-fixed sm:text-white">Barra Fría</span>
                    </div>
                    <div class="mt-1 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 pt-2.5 border-t border-white/8">
                      <span class="text-[11px] text-primary-fixed font-semibold tabular-nums">
                        Ahorro directo vs apps: +$11.98 USD
                      </span>
                      <button
                        type="button"
                        data-dispatch-btn
                        class="w-full sm:w-auto min-h-[42px] sm:min-h-[34px] inline-flex items-center justify-center gap-1.5 px-3.5 py-2 sm:py-1.5 rounded-lg bg-secondary-container hover:bg-secondary-accent text-white text-xs font-bold cursor-pointer transition-[transform,background-color] duration-150 ease-out active:scale-[0.96]"
                      >
                        <span data-dispatch-label>Marchar a entrega</span>
                        <Icon name="check" size={15} weight={700} />
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            {/* Ticket 2: WhatsApp Bot Synced */}
            <div
              class="t-acc t-resize rounded-xl bg-[#1a2720] p-3 sm:p-3.5 shadow-[0_0_0_1px_oklch(1_0_0/0.07)] transition-[background-color,box-shadow] duration-150"
              data-open="false"
              data-ticket-card
            >
              <button
                type="button"
                class="t-acc-head w-full min-h-[44px] flex items-center justify-between gap-2 text-left cursor-pointer"
                aria-expanded="false"
                data-ticket-toggle
              >
                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 min-w-0">
                  <span class="px-2 py-0.5 rounded-md bg-white/12 text-white text-[11px] font-extrabold tracking-tight tabular-nums shrink-0">
                    #WA-409
                  </span>
                  <span class="text-xs sm:text-sm font-bold text-white truncate">
                    WhatsApp Directo
                  </span>
                  <span class="text-[10px] sm:text-[11px] font-semibold text-[#b8ccc0] bg-white/8 px-2 py-0.5 rounded-full shrink-0">
                    Flota propia
                  </span>
                </div>
                <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white shrink-0 pl-1">
                  <span class="tabular-nums">$28.50</span>
                  <span class="t-acc-chevron w-4 h-4 text-[#9db3a6]">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <path d="M4 6.5L8 10.5L12 6.5"></path>
                    </svg>
                  </span>
                </div>
              </button>

              <div class="t-acc-panel">
                <div class="t-acc-panel-inner">
                  <div class="pt-3 mt-2.5 border-t border-white/10 flex flex-col gap-1.5 text-xs text-[#d6e5da] tabular-nums">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5">
                      <span>1× Combo Familiar Nikkei (24 pzs)</span>
                      <span class="text-primary-fixed font-semibold">Tracking GPS enviado</span>
                    </div>
                    <p class="text-[11px] text-[#a7bdb0]">
                      Cliente recurrente (6° pedido) · Cupón fidelidad canjeado automáticamente.
                    </p>
                  </div>
                </div>
              </div>
            </div>

            {/* Ticket 3: Aggregator Synced */}
            <div
              class="t-acc t-resize rounded-xl bg-[#1a2720] p-3 sm:p-3.5 shadow-[0_0_0_1px_oklch(1_0_0/0.07)] transition-[background-color,box-shadow] duration-150"
              data-open="false"
              data-ticket-card
            >
              <button
                type="button"
                class="t-acc-head w-full min-h-[44px] flex items-center justify-between gap-2 text-left cursor-pointer"
                aria-expanded="false"
                data-ticket-toggle
              >
                <div class="flex flex-wrap items-center gap-1.5 sm:gap-2 min-w-0">
                  <span class="px-2 py-0.5 rounded-md bg-secondary-container/25 text-[#ffb59d] text-[11px] font-extrabold tracking-tight tabular-nums shrink-0">
                    #RP-410
                  </span>
                  <span class="text-xs sm:text-sm font-bold text-white truncate">
                    Apps Delivery
                  </span>
                  <span class="text-[10px] sm:text-[11px] font-semibold text-[#ffb59d] bg-secondary-container/15 px-2 py-0.5 rounded-full shrink-0">
                    Auto-impreso
                  </span>
                </div>
                <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white shrink-0 pl-1">
                  <span class="tabular-nums">$34.00</span>
                  <span class="t-acc-chevron w-4 h-4 text-[#9db3a6]">
                    <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                      <path d="M4 6.5L8 10.5L12 6.5"></path>
                    </svg>
                  </span>
                </div>
              </button>

              <div class="t-acc-panel">
                <div class="t-acc-panel-inner">
                  <div class="pt-3 mt-2.5 border-t border-white/10 flex flex-col gap-1.5 text-xs text-[#d6e5da] tabular-nums">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-0.5">
                      <span>2× Pizza Napolitana Masa Madre</span>
                      <span class="text-[#ffb59d] font-semibold">Horno Piedra · 08:15</span>
                    </div>
                    <p class="text-[11px] text-[#a7bdb0]">
                      Ingresó directo a comanda sin re-digitar en caja ni errores de tablet.
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {/* Bottom Live Summary Footer */}
          <div class="mt-2 px-3 sm:px-3.5 py-2.5 rounded-xl bg-[#101814] shadow-[0_0_0_1px_oklch(1_0_0/0.07)] flex flex-wrap items-center justify-between gap-2">
            <div class="flex flex-col">
              <span class="text-[11px] text-[#9eb4a7] font-medium">
                Margen retenido hoy en canal directo
              </span>
              <span
                id="hero-saved-counter"
                class="text-base sm:text-lg font-extrabold text-primary-fixed tabular-nums"
              >
                +$318.40 USD
              </span>
            </div>
            <span class="text-[11px] text-[#bfd2c6] font-semibold bg-white/6 px-2.5 py-1 rounded-lg">
              Toca cualquier comanda
            </span>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<script>
  import gsap from 'gsap';

  function initHeroInteractions() {
    const tickets = document.querySelectorAll<HTMLElement>('[data-ticket-card]');
    tickets.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-ticket-toggle]');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const isOpen = card.getAttribute('data-open') === 'true';
        tickets.forEach((other) => {
          other.setAttribute('data-open', 'false');
          other.querySelector('[data-ticket-toggle]')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          card.setAttribute('data-open', 'true');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    const dispatchBtn = document.querySelector<HTMLButtonElement>('[data-dispatch-btn]');
    const dispatchLabel = document.querySelector<HTMLElement>('[data-dispatch-label]');
    const savedCounter = document.getElementById('hero-saved-counter');
    const avgLabel = document.getElementById('hero-kds-avg');

    if (dispatchBtn && dispatchLabel) {
      let dispatched = false;
      dispatchBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        dispatched = !dispatched;
        if (dispatched) {
          dispatchLabel.textContent = 'Despachado a repartidor';
          dispatchBtn.classList.remove('bg-secondary-container', 'hover:bg-secondary-accent');
          dispatchBtn.classList.add('bg-primary', 'text-white');
          if (savedCounter) savedCounter.textContent = '+$330.38 USD';
          if (avgLabel) avgLabel.textContent = '13m 45s';
        } else {
          dispatchLabel.textContent = 'Marchar a entrega';
          dispatchBtn.classList.add('bg-secondary-container', 'hover:bg-secondary-accent');
          dispatchBtn.classList.remove('bg-primary');
          if (savedCounter) savedCounter.textContent = '+$318.40 USD';
          if (avgLabel) avgLabel.textContent = '14m 20s';
        }
      });
    }

    const mm = gsap.matchMedia();
    mm.add(
      {
        canAnimate: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.canAnimate) return;

        const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
        tl.from('[data-hero-reveal]', {
          y: 16,
          autoAlpha: 0,
          duration: 0.65,
          stagger: 0.09,
          clearProps: 'transform,opacity,visibility',
        }).from(
          '[data-hero-board]',
          {
            y: 20,
            scale: 0.98,
            autoAlpha: 0,
            duration: 0.7,
            clearProps: 'transform,opacity,visibility',
          },
          '-=0.45'
        );
      }
    );
  }

  initHeroInteractions();
  document.addEventListener('astro:page-load', initHeroInteractions);
</script>
