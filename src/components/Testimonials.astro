---
import Container from './ui/Container.astro';
import SectionWrapper from './ui/SectionWrapper.astro';
import Icon from './ui/Icon.astro';

interface Testimonial {
  quote: string;
  author: string;
  role: string;
  location: string;
  initials: string;
  impactBadge: string;
  featured?: boolean;
}

const TESTIMONIALS: Testimonial[] = [
  {
    quote:
      'Antes perdíamos hasta el 28% de cada venta en comisiones de apps. Con la tienda propia de Nexofood pasamos el 45% de nuestras ventas a canal directo y ahorramos más de $2,400 USD mensuales.',
    author: 'Martín Benítez',
    role: 'Fundador en Burger Republic',
    location: 'Lima, Perú',
    initials: 'MB',
    impactBadge: '+$2,400 USD/mes ahorrados',
    featured: true,
  },
  {
    quote:
      'El KDS en cocina cambió el caos del fin de semana por un despacho ordenado. Cero comandas extraviadas y redujimos el tiempo de preparación promedio de 26 a 17 minutos.',
    author: 'Camila Restrepo',
    role: 'Chef Ejecutiva en Takumi Nikkei',
    location: 'Bogotá, Colombia',
    initials: 'CR',
    impactBadge: '26 min → 17 min en cocina',
  },
  {
    quote:
      'El tracking en vivo y los mensajes por WhatsApp hicieron que los clientes dejen de llamar preguntando por su pedido. La fidelización y pedidos recurrentes subieron un 35%.',
    author: 'Esteban Morales',
    role: 'Director de Operaciones en Donatello Pizza',
    location: 'Buenos Aires, Argentina',
    initials: 'EM',
    impactBadge: '+35% recompra directa',
  },
];
---

<SectionWrapper background="default" padding="lg" id="casos-de-exito">
  <Container>
    {/* Header */}
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8 sm:mb-10 md:mb-14">
      <div class="max-w-[36rem]">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight leading-tight">
          Probado y aprobado en cocinas de alto ritmo
        </h2>
        <p class="mt-2.5 sm:mt-3 text-sm sm:text-base md:text-lg text-on-surface-variant leading-relaxed">
          Descubre cómo dueños de restaurantes y franquicias transformaron sus
          operaciones diarias y dispararon su rentabilidad neta.
        </p>
      </div>
      <div class="flex items-center gap-2 text-xs sm:text-sm font-bold text-on-surface bg-surface-container-lowest px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl shadow-[var(--shadow-border)] w-full sm:w-auto md:self-end tabular-nums">
        <span class="text-amber-500 flex shrink-0">
          <Icon name="star" size={18} fill={true} />
        </span>
        <span>4.9/5 calificación promedio en +1,200 locales</span>
      </div>
    </div>

    {/* Testimonials Grid: Mobile-first */}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 sm:gap-6 md:gap-8 items-stretch">
      {TESTIMONIALS.map((t) => (
        <figure
          class={`rounded-2xl sm:rounded-3xl p-5 sm:p-8 flex flex-col justify-between gap-5 sm:gap-6 transition-[transform,box-shadow] duration-200 ease-out hover:-translate-y-0.5 ${
            t.featured
              ? 'bg-[#131e18] text-inverse-on-surface shadow-[0_18px_38px_-10px_rgba(0,0,0,0.35)]'
              : 'bg-surface-container-lowest text-on-surface shadow-[var(--shadow-border)] hover:shadow-[var(--shadow-border-hover)]'
          }`}
        >
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex gap-0.5 text-amber-500" aria-label="Calificación 5 estrellas">
              {[1, 2, 3, 4, 5].map(() => (
                <Icon name="star" size={17} fill={true} />
              ))}
            </div>
            <span
              class={`text-[11px] font-extrabold px-2.5 py-1 rounded-full tabular-nums ${
                t.featured
                  ? 'bg-primary/40 text-primary-fixed'
                  : 'bg-mint-subtle text-primary'
              }`}
            >
              {t.impactBadge}
            </span>
          </div>

          <blockquote
            class={`font-editorial text-lg sm:text-xl leading-relaxed italic grow ${
              t.featured ? 'text-white' : 'text-on-surface'
            }`}
          >
            “{t.quote}”
          </blockquote>

          <figcaption
            class={`flex items-center gap-3.5 border-t pt-4 ${
              t.featured ? 'border-white/12' : 'border-surface-container'
            }`}
          >
            <div
              class={`w-11 h-11 rounded-full flex items-center justify-center font-extrabold text-sm shrink-0 ${
                t.featured
                  ? 'bg-primary-fixed text-on-primary-fixed'
                  : 'bg-primary text-on-primary'
              }`}
            >
              {t.initials}
            </div>
            <div class="flex flex-col">
              <span
                class={`text-sm font-bold ${
                  t.featured ? 'text-white' : 'text-on-surface'
                }`}
              >
                {t.author}
              </span>
              <span
                class={`text-xs ${
                  t.featured ? 'text-[#b4c8bc]' : 'text-on-surface-variant'
                }`}
              >
                {t.role} · {t.location}
              </span>
            </div>
          </figcaption>
        </figure>
      ))}
    </div>
  </Container>
</SectionWrapper>
