---
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';

interface BenefitPillar {
  id: string;
  tag: string;
  title: string;
  headline: string;
  description: string;
  highlight: string;
  metrics: { value: string; label: string }[];
  uiKind: 'storefront' | 'kds' | 'radar';
}

const BENEFIT_PILLARS: BenefitPillar[] = [
  {
    id: 'margen-directo',
    tag: 'Canal Directo · Tienda Online Propia',
    title: 'Conserva hasta el 96.5% de cada venta',
    headline:
      'Deja de regalar tu rentabilidad en comisiones de terceros y cobra directo en tu cuenta.',
    description:
      'Publica tu catálogo web y móvil con tu propia marca, sugiere acompañamientos automáticos para elevar el ticket y procesa pagos con Mercado Pago desde 3.49% + S/ 1.',
    highlight: 'Sin comisiones por pedido de parte de Nexofood',
    metrics: [
      { value: '0%', label: 'Comisión Nexofood' },
      { value: '3.49%', label: 'Solo tasa Mercado Pago' },
      { value: '+18%', label: 'Ticket con upselling' },
    ],
    uiKind: 'storefront',
  },
  {
    id: 'cocina-sincronizada',
    tag: 'Producción · KDS en Cocina',
    title: 'Despacho ágil sin comandas perdidas',
    headline:
      'Centraliza cada pedido en pantallas de cocina organizadas por estación y tiempo de cocción.',
    description:
      'Elimina los errores de transcripción manual en horas pico. Tus cocineros ven prioridades claras, alertas de demora y el estado de cada orden en tiempo real.',
    highlight: 'Compatible con tablets, monitores e impresoras térmicas',
    metrics: [
      { value: '0', label: 'Re-digitación manual' },
      { value: '12 min', label: 'Alerta visual SLA' },
      { value: '100%', label: 'Trazabilidad en vivo' },
    ],
    uiKind: 'kds',
  },
  {
    id: 'logistica-clientes',
    tag: 'Logística & Fidelización · Control Total',
    title: 'Entregas transparentes y clientes propios',
    headline:
      'Coordina repartidores con seguimiento en vivo y construye tu propia base de datos de comensales.',
    description:
      'Reduce las llamadas preguntando por el estado del pedido enviando un enlace de rastreo en tiempo real y conserva el historial de cada cliente para impulsar su recompra.',
    highlight: 'Tu base de clientes te pertenece al 100%',
    metrics: [
      { value: 'GPS', label: 'Tracking en vivo' },
      { value: '100%', label: 'Datos propios' },
      { value: '24/7', label: 'Operación continua' },
    ],
    uiKind: 'radar',
  },
];
---

<section id="beneficios" class="w-full bg-surface-container-lowest text-on-surface border-b border-border-subtle py-16 sm:py-24 lg:py-28">
  <Container>
    {/* Section Header */}
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 pb-12 sm:pb-16 border-b border-outline-variant/50">
      <h2 data-split="cases" class="type-h2 font-bold text-on-surface max-w-[44rem]">
        Cómo Nexofood transforma la rentabilidad y operación de tu empresa.
      </h2>
      <div class="flex items-center gap-3 text-xs sm:text-sm font-semibold text-on-surface-variant tabular-nums shrink-0">
        <span class="w-2.5 h-2.5 rounded-full bg-primary-container"></span>
        <span>Arquitectura pensada para negocios gastronómicos</span>
      </div>
    </div>

    {/* Alternating Full-Width Benefit Pillars */}
    <div class="flex flex-col divide-y divide-outline-variant/50">
      {BENEFIT_PILLARS.map((item, idx) => {
        const isReversed = idx % 2 === 1;
        return (
          <article class="py-12 sm:py-16 lg:py-20 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            {/* Editorial Copy + 3-Metric Strip */}
            <div
              class={`lg:col-span-5 flex flex-col justify-between gap-7 ${
                isReversed ? 'lg:order-2' : 'lg:order-1'
              }`}
            >
              <div class="flex flex-col gap-4">
                <span class="font-mono text-xs text-primary font-semibold tracking-wide">
                  {item.tag}
                </span>
                <h3 class="type-h3 font-bold text-on-surface">
                  {item.title}
                </h3>
                <p class="font-editorial italic text-xl sm:text-2xl text-on-surface leading-snug">
                  {item.headline}
                </p>
                <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed">
                  {item.description}
                </p>
                <div class="text-xs sm:text-sm text-primary font-semibold">
                  {item.highlight}
                </div>
              </div>

              {/* 3-Column Metrics Row (Eloqwnt .h-w-result-wrap) */}
              <div class="grid grid-cols-3 gap-4 pt-6 border-t border-outline-variant/50 tabular-nums">
                {item.metrics.map((m) => (
                  <div>
                    <div class="text-xl sm:text-2xl font-bold text-primary tracking-tight">
                      {m.value}
                    </div>
                    <div class="text-xs text-on-surface-variant mt-1 leading-snug">
                      {m.label}
                    </div>
                  </div>
                ))}
              </div>

              <a
                href="/#productos"
                class="eloq-link w-fit text-sm font-bold text-on-surface hover:text-primary transition-colors"
              >
                <span class="inline-flex items-center gap-2 py-1">
                  <span>Ver arquitectura aplicada</span>
                  <Icon name="arrow_right" size={16} />
                </span>
                <span class="eloq-link-line"></span>
              </a>
            </div>

            {/* Large Interactive Product Viewport Showcase (Eloqwnt .img-project-wrapper) */}
            <div
              class={`lg:col-span-7 ${isReversed ? 'lg:order-1' : 'lg:order-2'}`}
              data-case-visual
            >
              <div class="rounded-2xl bg-inverse-surface text-inverse-on-surface p-5 sm:p-8 border border-white/10 shadow-level-2 overflow-hidden relative">
                <div class="flex items-center justify-between pb-4 mb-5 border-b border-white/10 font-mono text-xs text-[#b4c8bc]">
                  <span>
                    {item.uiKind === 'storefront' && 'STOREFRONT.NEXOFOOD / CHECKOUT MERCADO PAGO'}
                    {item.uiKind === 'kds' && 'KDS.CENTRAL / 4 ESTACIONES ACTIVAS'}
                    {item.uiKind === 'radar' && 'DELIVERY.GPS / TRACKING WEB'}
                  </span>
                  <span class="text-primary-fixed">LIVE TELEMETRY</span>
                </div>

                {item.uiKind === 'storefront' && (
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 items-center">
                    <div class="flex flex-col gap-3">
                      <div class="p-3.5 rounded-xl bg-white/[0.05] border border-white/10">
                        <div class="text-xs text-[#b4c8bc]">Pedido directo · Web propia</div>
                        <div class="text-lg font-bold text-white mt-1">Combo Clásico × 2</div>
                        <div class="font-mono text-xs text-primary-fixed mt-1 tabular-nums">
                          + Upselling automático: Papas Artesanales (S/ 16.00)
                        </div>
                      </div>
                      <div class="p-3.5 rounded-xl bg-primary/25 border border-primary-fixed/30 flex items-center justify-between gap-2 tabular-nums">
                        <span class="text-xs font-medium text-white">Cobro directo vía Mercado Pago</span>
                        <span class="font-mono text-sm font-bold text-primary-fixed shrink-0">3.49% MP</span>
                      </div>
                    </div>
                    <div class="p-4 rounded-xl bg-[#0b110e] border border-white/10 flex flex-col gap-3 tabular-nums">
                      <div class="flex justify-between text-xs text-[#b4c8bc]">
                        <span>Total venta directa</span>
                        <span class="text-white font-bold">S/ 148.00</span>
                      </div>
                      <div class="flex justify-between text-xs text-[#b4c8bc]">
                        <span>Tarifa Mercado Pago</span>
                        <span class="text-secondary-fixed font-bold">-S/ 6.17</span>
                      </div>
                      <div class="h-px bg-white/10"></div>
                      <div class="flex justify-between text-sm font-bold text-white">
                        <span>Ingreso neto local</span>
                        <span class="text-primary-fixed">S/ 141.83</span>
                      </div>
                    </div>
                  </div>
                )}

                {item.uiKind === 'kds' && (
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 tabular-nums">
                    <div class="p-3.5 rounded-xl bg-white/[0.05] border border-white/10 flex flex-col gap-2">
                      <div class="flex justify-between font-mono text-xs text-primary-fixed">
                        <span>#RP-812</span>
                        <span>06:14</span>
                      </div>
                      <div class="text-sm font-bold text-white">Barra Fría</div>
                      <div class="text-xs text-[#c7dcd0]">2× Acevichado Roll + Gyozas</div>
                      <span class="mt-auto text-[11px] font-semibold text-primary-fixed">En armado</span>
                    </div>
                    <div class="p-3.5 rounded-xl bg-white/[0.05] border border-white/10 flex flex-col gap-2">
                      <div class="flex justify-between font-mono text-xs text-secondary-fixed">
                        <span>#NF-813</span>
                        <span>04:40</span>
                      </div>
                      <div class="text-sm font-bold text-white">Plancha Wok</div>
                      <div class="text-xs text-[#c7dcd0]">1× Lomo Saltado Nikkei</div>
                      <span class="mt-auto text-[11px] font-semibold text-secondary-fixed">Prioridad alta</span>
                    </div>
                    <div class="p-3.5 rounded-xl bg-primary/25 border border-primary-fixed/30 flex flex-col gap-2">
                      <div class="flex justify-between font-mono text-xs text-primary-fixed">
                        <span>#WA-814</span>
                        <span>LISTO</span>
                      </div>
                      <div class="text-sm font-bold text-white">Empaque</div>
                      <div class="text-xs text-[#ebf3eb]">Listo en 17 min totales</div>
                      <span class="mt-auto text-[11px] font-bold text-primary-fixed">Sin re-digitación</span>
                    </div>
                  </div>
                )}

                {item.uiKind === 'radar' && (
                  <div class="grid grid-cols-1 sm:grid-cols-[1.1fr_0.9fr] gap-5 items-center tabular-nums">
                    <div class="p-4 rounded-xl bg-[#0b110e] border border-white/10 flex flex-col gap-3">
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-primary-fixed font-semibold">En camino · Motorizado #04</span>
                        <span class="font-mono text-white">ETA 07 min</span>
                      </div>
                      <div class="h-2 w-full rounded-full bg-white/10 overflow-hidden">
                        <div class="h-full w-4/5 bg-primary-fixed rounded-full"></div>
                      </div>
                      <p class="text-xs text-[#b4c8bc]">
                        Enlace web de seguimiento GPS en tiempo real sin que el cliente descargue aplicaciones.
                      </p>
                    </div>
                    <div class="p-4 rounded-xl bg-white/[0.05] border border-white/10 flex flex-col gap-1.5">
                      <span class="font-mono text-xs text-secondary-fixed">CRM · CLIENTE RECURRENTE</span>
                      <span class="text-sm font-bold text-white">Cupón 14 días activado</span>
                      <span class="text-xs text-[#c7dcd0]">+35% tasa de recompra directa</span>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </Container>
</section>

<script>
  import { ensureGsapRegistered } from '../scripts/gsap-setup';

  function initSelectedKitchens() {
    const { gsap, ScrollTrigger } = ensureGsapRegistered();

    const mm = gsap.matchMedia();
    mm.add(
      {
        canAnimate: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.canAnimate) return;

        ScrollTrigger.batch('[data-case-visual]', {
          start: 'top 92%',
          once: true,
          onEnter: (batch) => {
            gsap.fromTo(
              batch,
              { y: 24, clipPath: 'inset(6% 0% 6% 0%)' },
              {
                y: 0,
                clipPath: 'inset(0% 0% 0% 0%)',
                duration: 0.75,
                stagger: 0.1,
                ease: 'power3.out',
                clearProps: 'transform,clipPath',
              }
            );
          },
        });
      }
    );

    return () => mm.revert();
  }

  let cleanupCases: (() => void) | undefined;
  const mount = () => {
    cleanupCases?.();
    cleanupCases = initSelectedKitchens();
  };
  mount();
  document.addEventListener('astro:page-load', mount);
</script>
