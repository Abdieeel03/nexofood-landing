---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
---

<header
  id="site-header"
  class="fixed top-0 left-0 w-full z-50 bg-surface-container-lowest/92 backdrop-blur-md border-b border-border-subtle transition-[background-color,box-shadow] duration-200 ease-out"
>
  <Container>
    <div class="flex justify-between items-center py-2.5 sm:py-3.5">
      {/* Brand Logo */}
      <a
        href="/#inicio"
        class="nav-link inline-flex items-center gap-2 min-h-[44px] text-lg sm:text-2xl font-extrabold text-primary tracking-tight transition-opacity duration-150 hover:opacity-85 active:scale-[0.96]"
      >
        <span class="w-8 h-8 rounded-lg bg-primary text-on-primary inline-flex items-center justify-center shadow-[0_2px_6px_rgba(0,108,73,0.25)] shrink-0">
          <Icon name="restaurant" size={18} fill={true} />
        </span>
        <span>Nexofood</span>
      </a>

      {/* Desktop Navigation */}
      <nav class="hidden lg:flex items-center gap-1" aria-label="Navegación principal">
        <a
          href="/#por-que"
          class="px-3.5 py-2 rounded-lg text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-low/70 transition-[color,background-color] duration-150"
        >
          Impacto Operativo
        </a>
        <a
          href="/#productos"
          class="px-3.5 py-2 rounded-lg text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-low/70 transition-[color,background-color] duration-150"
        >
          Módulos
        </a>
        <a
          href="/#precios"
          class="px-3.5 py-2 rounded-lg text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-low/70 transition-[color,background-color] duration-150"
        >
          Planes y Ahorro
        </a>
        <a
          href="/#casos-de-exito"
          class="px-3.5 py-2 rounded-lg text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-low/70 transition-[color,background-color] duration-150"
        >
          Cocinas Reales
        </a>
      </nav>

      {/* Actions */}
      <div class="flex items-center gap-2 sm:gap-3">
        <a
          href="/#comienza-gratis"
          class="hidden lg:inline-flex items-center min-h-[40px] px-3.5 py-2 rounded-xl text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container-low transition-[color,background-color,transform] duration-150 active:scale-[0.96]"
        >
          Acceso Clientes
        </a>
        <Button
          variant="primary"
          size="sm"
          href="/#comienza-gratis"
          class="min-h-[40px] sm:min-h-[42px] px-3 sm:px-4 text-xs sm:text-sm"
        >
          Comienza Gratis
        </Button>

        {/* Mobile Menu Trigger with Contextual Icon Cross-Fade (44x44 hit area) */}
        <button
          id="mobile-menu-btn"
          type="button"
          class="relative flex lg:hidden items-center justify-center w-11 h-11 text-on-surface hover:bg-surface-container rounded-xl transition-[background-color,transform] duration-150 ease-out active:scale-[0.96] cursor-pointer shrink-0"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <span class="relative flex items-center justify-center w-6 h-6">
            <span
              id="menu-icon-open"
              class="flex items-center justify-center transition-[opacity,filter,scale] duration-300 ease-[cubic-bezier(0.2,0,0,1)] scale-100 opacity-100 blur-0"
            >
              <Icon name="menu" size={24} weight={600} />
            </span>
            <span
              id="menu-icon-close"
              class="absolute inset-0 flex items-center justify-center transition-[opacity,filter,scale] duration-300 ease-[cubic-bezier(0.2,0,0,1)] scale-[0.25] opacity-0 blur-[4px]"
            >
              <Icon name="close" size={24} weight={600} />
            </span>
          </span>
        </button>
      </div>
    </div>
  </Container>

  {/* Interruptible Mobile Drawer using t-acc grid-rows transition */}
  <div
    id="mobile-menu-drawer"
    class="t-acc lg:hidden w-full bg-surface-container-lowest border-b border-border-subtle shadow-level-2"
    data-open="false"
    aria-hidden="true"
  >
    <div class="t-acc-panel">
      <div class="t-acc-panel-inner max-h-[calc(100dvh-4rem)] overflow-y-auto">
        <Container>
          <div class="py-3.5 flex flex-col gap-3">
            <div class="flex flex-col gap-1">
              <a
                href="/#por-que"
                class="nav-link min-h-[46px] flex items-center justify-between px-3.5 py-2.5 text-base font-semibold text-on-surface rounded-xl hover:bg-surface-container-low active:bg-surface-container hover:text-primary transition-[background-color,color] duration-150"
              >
                <span>Impacto Operativo</span>
                <Icon name="chevron_right" size={18} class="text-on-surface-variant" />
              </a>
              <a
                href="/#productos"
                class="nav-link min-h-[46px] flex items-center justify-between px-3.5 py-2.5 text-base font-semibold text-on-surface rounded-xl hover:bg-surface-container-low active:bg-surface-container hover:text-primary transition-[background-color,color] duration-150"
              >
                <span>Módulos</span>
                <Icon name="chevron_right" size={18} class="text-on-surface-variant" />
              </a>
              <a
                href="/#precios"
                class="nav-link min-h-[46px] flex items-center justify-between px-3.5 py-2.5 text-base font-semibold text-on-surface rounded-xl hover:bg-surface-container-low active:bg-surface-container hover:text-primary transition-[background-color,color] duration-150"
              >
                <span>Planes y Ahorro</span>
                <Icon name="chevron_right" size={18} class="text-on-surface-variant" />
              </a>
              <a
                href="/#casos-de-exito"
                class="nav-link min-h-[46px] flex items-center justify-between px-3.5 py-2.5 text-base font-semibold text-on-surface rounded-xl hover:bg-surface-container-low active:bg-surface-container hover:text-primary transition-[background-color,color] duration-150"
              >
                <span>Cocinas Reales</span>
                <Icon name="chevron_right" size={18} class="text-on-surface-variant" />
              </a>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-3 border-t border-border-subtle">
              <Button
                variant="outline"
                fullWidth
                size="md"
                href="/#comienza-gratis"
                class="nav-link"
              >
                Acceso Clientes
              </Button>
              <Button
                variant="primary"
                fullWidth
                size="md"
                href="/#comienza-gratis"
                class="nav-link"
              >
                Comienza Gratis
              </Button>
            </div>
          </div>
        </Container>
      </div>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const header = document.getElementById('site-header');
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!btn || !drawer || !openIcon || !closeIcon) return;

    let isOpen = false;

    function toggle(forceState?: boolean) {
      isOpen = typeof forceState === 'boolean' ? forceState : !isOpen;
      drawer.setAttribute('data-open', String(isOpen));
      drawer.setAttribute('aria-hidden', String(!isOpen));
      btn.setAttribute('aria-expanded', String(isOpen));
      btn.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');

      if (isOpen) {
        openIcon.classList.remove('scale-100', 'opacity-100', 'blur-0');
        openIcon.classList.add('scale-[0.25]', 'opacity-0', 'blur-[4px]');
        closeIcon.classList.remove('scale-[0.25]', 'opacity-0', 'blur-[4px]');
        closeIcon.classList.add('scale-100', 'opacity-100', 'blur-0');
      } else {
        openIcon.classList.remove('scale-[0.25]', 'opacity-0', 'blur-[4px]');
        openIcon.classList.add('scale-100', 'opacity-100', 'blur-0');
        closeIcon.classList.remove('scale-100', 'opacity-100', 'blur-0');
        closeIcon.classList.add('scale-[0.25]', 'opacity-0', 'blur-[4px]');
      }
    }

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    const navLinks = drawer.querySelectorAll('.nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => toggle(false));
    });

    document.addEventListener('click', (e) => {
      if (isOpen && header && !header.contains(e.target as Node)) {
        toggle(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) toggle(false);
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
