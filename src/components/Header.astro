---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
---

<header class="fixed top-0 left-0 w-full z-50 bg-white/85 backdrop-blur-md border-b border-border-subtle transition-all duration-200">
  <Container>
    <div class="flex justify-between items-center py-3.5 md:py-4">
      {/* Logo */}
      <a
        href="#"
        class="nav-link flex items-center gap-1.5 text-xl sm:text-2xl font-extrabold text-primary tracking-tight hover:opacity-90 transition-opacity"
      >
        <span>Nexofood</span>
        <span class="text-secondary-container flex items-center">
          <Icon name="restaurant" size={24} fill={true} />
        </span>
      </a>

      {/* Desktop Nav */}
      <nav class="hidden lg:flex items-center gap-8" aria-label="Navegación principal">
        <a
          href="#por-que"
          class="relative text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors py-1 group"
        >
          ¿Por qué Nexofood?
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-container rounded-full transition-all duration-200 group-hover:w-full"></span>
        </a>
        <a
          href="#productos"
          class="relative text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors py-1 group"
        >
          Productos
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-container rounded-full transition-all duration-200 group-hover:w-full"></span>
        </a>
        <a
          href="#precios"
          class="relative text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors py-1 group"
        >
          Precios
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-container rounded-full transition-all duration-200 group-hover:w-full"></span>
        </a>
        <a
          href="#casos-de-exito"
          class="relative text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors py-1 group"
        >
          Casos de Éxito
          <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-primary-container rounded-full transition-all duration-200 group-hover:w-full"></span>
        </a>
      </nav>

      {/* Actions */}
      <div class="flex items-center gap-3 md:gap-4">
        <a
          href="/login"
          class="hidden lg:inline-block text-sm font-semibold text-on-surface-variant hover:text-primary hover:bg-surface-container px-3 py-2 rounded-lg transition-colors"
        >
          Iniciar sesión
        </a>
        <Button
          variant="primary"
          size="md"
          href="#comienza-gratis"
          class="text-xs sm:text-sm py-2 px-3 sm:py-2.5 sm:px-4"
        >
          Comienza Gratis
        </Button>
        <button
          id="mobile-menu-btn"
          class="flex lg:hidden items-center justify-center p-1.5 text-on-surface hover:bg-surface-container rounded-lg transition-colors cursor-pointer"
          aria-label="Abrir menú"
          aria-expanded="false"
        >
          <span id="menu-icon-open" class="flex"><Icon name="menu" size={28} /></span>
          <span id="menu-icon-close" class="hidden"><Icon name="close" size={28} /></span>
        </button>
      </div>
    </div>
  </Container>

  {/* Mobile Drawer */}
  <div
    id="mobile-menu-drawer"
    class="lg:hidden fixed top-[61px] sm:top-[68px] left-0 w-full bg-surface-container-lowest border-b border-outline-variant p-5 shadow-level-3 flex-col gap-4 z-40 hidden"
    aria-hidden="true"
  >
    <div class="flex flex-col gap-2">
      <a
        href="#por-que"
        class="nav-link px-4 py-3 text-base font-semibold text-on-surface rounded-lg hover:bg-surface-container-low hover:text-primary transition-colors"
      >
        ¿Por qué Nexofood?
      </a>
      <a
        href="#productos"
        class="nav-link px-4 py-3 text-base font-semibold text-on-surface rounded-lg hover:bg-surface-container-low hover:text-primary transition-colors"
      >
        Productos
      </a>
      <a
        href="#precios"
        class="nav-link px-4 py-3 text-base font-semibold text-on-surface rounded-lg hover:bg-surface-container-low hover:text-primary transition-colors"
      >
        Precios
      </a>
      <a
        href="#casos-de-exito"
        class="nav-link px-4 py-3 text-base font-semibold text-on-surface rounded-lg hover:bg-surface-container-low hover:text-primary transition-colors"
      >
        Casos de Éxito
      </a>
    </div>
    <div class="flex flex-col gap-2 pt-4 border-t border-surface-container-high">
      <Button
        variant="outline"
        fullWidth
        size="md"
        href="/login"
        class="nav-link"
      >
        Iniciar sesión
      </Button>
      <Button
        variant="primary"
        fullWidth
        size="md"
        href="#comienza-gratis"
        class="nav-link"
      >
        Comienza Gratis
      </Button>
    </div>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-menu-drawer');
    const openIcon = document.getElementById('menu-icon-open');
    const closeIcon = document.getElementById('menu-icon-close');

    if (!btn || !drawer || !openIcon || !closeIcon) return;

    let isOpen = false;

    function toggle(forceState?: boolean) {
      isOpen = typeof forceState === 'boolean' ? forceState : !isOpen;
      if (isOpen) {
        drawer.classList.remove('hidden');
        drawer.classList.add('flex');
        openIcon.classList.add('hidden');
        openIcon.classList.remove('flex');
        closeIcon.classList.remove('hidden');
        closeIcon.classList.add('flex');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Cerrar menú');
        drawer.setAttribute('aria-hidden', 'false');
      } else {
        drawer.classList.add('hidden');
        drawer.classList.remove('flex');
        openIcon.classList.remove('hidden');
        openIcon.classList.add('flex');
        closeIcon.classList.add('hidden');
        closeIcon.classList.remove('flex');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Abrir menú');
        drawer.setAttribute('aria-hidden', 'true');
      }
    }

    btn.addEventListener('click', () => toggle());

    const navLinks = drawer.querySelectorAll('.nav-link');
    navLinks.forEach((link) => {
      link.addEventListener('click', () => toggle(false));
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
