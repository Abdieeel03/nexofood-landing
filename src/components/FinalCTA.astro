---
import Container from './ui/Container.astro';
import Button from './ui/Button.astro';
---

<section class="relative bg-inverse-surface text-inverse-on-surface py-12 md:py-20 overflow-hidden text-center" id="comienza-gratis">
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(16,185,129,0.18)_0%,rgba(22,31,26,0)_70%)] pointer-events-none"></div>
  <Container>
    <div class="relative z-10 max-w-[48.75rem] mx-auto flex flex-col items-center gap-5 sm:gap-6">
      <h2 class="text-2xl sm:text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight sm:leading-snug md:leading-[3.5rem]">
        Lleva tu restaurante al siguiente nivel hoy mismo
      </h2>
      <p class="text-sm sm:text-base md:text-lg text-inverse-on-surface/85 max-w-[38.75rem] leading-relaxed">
        Únete a miles de negocios que ya optimizaron sus operaciones y
        aumentaron sus márgenes de ganancia con Nexofood.
      </p>
      <div class="mt-2">
        <Button
          variant="primary"
          size="lg"
          icon="arrow_forward"
          href="#inicio"
        >
          Comenzar Prueba Gratuita
        </Button>
      </div>
    </div>
  </Container>
</section>
