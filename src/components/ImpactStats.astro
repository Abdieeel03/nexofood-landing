---
import Container from './ui/Container.astro';
import SectionWrapper from './ui/SectionWrapper.astro';

interface StatItem {
  value: string;
  numericTarget: number;
  prefix: string;
  suffix: string;
  decimals: number;
  label: string;
  context: string;
}

const STATS: StatItem[] = [
  {
    value: '+15%',
    numericTarget: 15,
    prefix: '+',
    suffix: '%',
    decimals: 0,
    label: 'Aumento Ticket Promedio',
    context: 'Gracias al upselling automático de bebidas y acompañamientos en el checkout.',
  },
  {
    value: '+100k',
    numericTarget: 100,
    prefix: '+',
    suffix: 'k',
    decimals: 0,
    label: 'Negocios Activos',
    context: 'Desde locales independientes hasta cadenas con más de 40 sucursales.',
  },
  {
    value: '0%',
    numericTarget: 0,
    prefix: '',
    suffix: '%',
    decimals: 0,
    label: 'Comisiones Sorpresa',
    context: 'Cada venta por tu tienda online va íntegra a tu flujo de caja.',
  },
  {
    value: '99.9%',
    numericTarget: 99.9,
    prefix: '',
    suffix: '%',
    decimals: 1,
    label: 'Uptime Garantizado',
    context: 'Infraestructura redundante para viernes y sábados de máxima demanda.',
  },
];
---

<SectionWrapper background="surface" padding="lg" id="por-que" borderBottom={true}>
  <Container>
    <div class="flex flex-col gap-6 sm:gap-8 md:gap-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-3 sm:gap-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight leading-tight max-w-[32rem]">
          Ingeniería operativa que se nota en el cierre de caja
        </h2>
        <p class="text-sm sm:text-base text-on-surface-variant max-w-[28rem] leading-relaxed">
          Reemplaza el caos de múltiples tablets y comisiones del <span class="tabular-nums font-semibold text-on-surface">28%</span> por un flujo directo diseñado para gastronomía.
        </p>
      </div>

      {/* Mobile-first 1px hairline grid (works seamlessly on 1-col mobile, 2x2 tablet, and 4-col desktop) */}
      <div
        id="impact-stats-ledger"
        class="rounded-2xl sm:rounded-3xl bg-outline-variant/45 p-px shadow-[var(--shadow-border)] overflow-hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px"
      >
        {STATS.map((stat) => (
          <div class="bg-surface-container-lowest p-5 sm:p-6 lg:p-7 flex flex-col justify-between gap-2.5 sm:gap-3 hover:bg-surface-container-low/45 transition-[background-color] duration-150">
            <div class="flex flex-col gap-1">
              <div
                class="text-3xl sm:text-4xl lg:text-[2.75rem] font-extrabold text-primary tracking-tight leading-none tabular-nums"
                data-stat-counter
                data-target={stat.numericTarget}
                data-prefix={stat.prefix}
                data-suffix={stat.suffix}
                data-decimals={stat.decimals}
              >
                {stat.value}
              </div>
              <div class="text-sm sm:text-base font-bold text-on-surface mt-1">
                {stat.label}
              </div>
            </div>
            <p class="text-xs sm:text-sm text-on-surface-variant leading-relaxed">
              {stat.context}
            </p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</SectionWrapper>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initStatsAnimation() {
    const counters = document.querySelectorAll<HTMLElement>('[data-stat-counter]');
    if (!counters.length) return;

    const mm = gsap.matchMedia();
    mm.add(
      {
        canAnimate: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.canAnimate) return;

        counters.forEach((el) => {
          const target = parseFloat(el.dataset.target || '0');
          const prefix = el.dataset.prefix || '';
          const suffix = el.dataset.suffix || '';
          const decimals = parseInt(el.dataset.decimals || '0', 10);

          if (target === 0) return;

          const state = { val: 0 };
          gsap.to(state, {
            val: target,
            duration: 1.1,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: el,
              start: 'top 88%',
              once: true,
            },
            onUpdate() {
              el.textContent = `${prefix}${state.val.toFixed(decimals)}${suffix}`;
            },
          });
        });
      }
    );
  }

  initStatsAnimation();
  document.addEventListener('astro:page-load', initStatsAnimation);
</script>
