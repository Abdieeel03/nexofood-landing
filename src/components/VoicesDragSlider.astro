---
import Container from './ui/Container.astro';
import Icon from './ui/Icon.astro';

const ENTREPRENEUR_BENEFITS = [
  {
    badge: 'Plan Starter S/ 0',
    tag: '01',
    title: 'Lanza tu tienda online sin inversión en desarrollo',
    description:
      'Empieza a vender por internet en minutos con tu propia carta digital, fotos y dominio sin pagar agencias ni programadores.',
    highlightTitle: 'Ideal para validar y crecer',
    highlightSub: 'Activa tu catálogo hoy sin costo fijo mensual',
    initials: '01',
  },
  {
    badge: 'Solo 3.49% MP',
    tag: '02',
    title: 'Protege tu margen desde el primer pedido',
    description:
      'Evita ceder hasta el 28% de cada plato a apps intermediarias. Cobra directo con Mercado Pago y reinvierte esa ganancia en tu negocio.',
    highlightTitle: 'Liquidez inmediata',
    highlightSub: 'El dinero de tus ventas ingresa directo a tu cuenta',
    initials: '02',
  },
  {
    badge: 'Orden en cocina',
    tag: '03',
    title: 'Controla horas pico con un equipo pequeño',
    description:
      'Recibe órdenes organizadas en pantalla KDS o impresora térmica para evitar confusiones, comandas traspapeladas y retrasos.',
    highlightTitle: 'Operación profesional',
    highlightSub: 'Flujo claro desde que entra el pedido hasta el despacho',
    initials: '03',
  },
  {
    badge: '100% tus datos',
    tag: '04',
    title: 'Construye tu propia cartera de comensales',
    description:
      'Conoce quién te compra, qué platos prefiere y con qué frecuencia pide para fidelizarlo con promociones directas sin pagar por visibilidad.',
    highlightTitle: 'Clientes recurrentes',
    highlightSub: 'Convierte compradores ocasionales en habituales',
    initials: '04',
  },
  {
    badge: 'Escala flexible',
    tag: '05',
    title: 'Crece a tu ritmo, sin contratos forzados',
    description:
      'Comienza con un solo local y activa pasarela integrada, logística GPS o gestión multi-sucursal conforme tu emprendimiento despegue.',
    highlightTitle: 'Sin ataduras',
    highlightSub: 'Cambia de plan o escala cuando tu cocina lo pida',
    initials: '05',
  },
];
---

<section class="w-full bg-surface text-on-surface border-b border-border-subtle py-16 sm:py-24 overflow-hidden">
  <Container>
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-10 sm:mb-12">
      <h2 class="type-h2 font-bold text-on-surface max-w-[40rem]">
        Diseñado para impulsar a empresas de comida emprendedoras.
      </h2>
      <p class="text-sm text-on-surface-variant font-medium">
        Arrastra horizontalmente o usa los controles
      </p>
    </div>

    {/* Eloqwnt Draggable Carousel Track */}
    <div id="voices-viewport" class="relative overflow-hidden">
      <div id="voices-track" class="flex gap-6 w-max cursor-grab active:cursor-grabbing select-none">
        {ENTREPRENEUR_BENEFITS.map((item) => (
          <figure class="w-[82vw] sm:w-[27rem] lg:w-[30rem] shrink-0 p-7 sm:p-8 rounded-2xl bg-surface-container-lowest border border-outline-variant/55 flex flex-col justify-between gap-8">
            <div class="flex items-center justify-between gap-3">
              <span class="font-mono text-xs font-bold px-3 py-1 rounded-full bg-mint-subtle text-primary tabular-nums">
                {item.badge}
              </span>
              <span class="font-mono text-xs font-semibold text-on-surface-variant tabular-nums">
                VENTAJA {item.tag}
              </span>
            </div>

            <div class="flex flex-col gap-3">
              <h3 class="font-editorial italic text-xl sm:text-2xl text-on-surface leading-snug">
                {item.title}
              </h3>
              <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed">
                {item.description}
              </p>
            </div>

            <figcaption class="pt-5 border-t border-outline-variant/45 flex items-center gap-3.5">
              <div class="w-11 h-11 rounded-full bg-primary text-on-primary font-mono font-bold text-sm flex items-center justify-center shrink-0">
                {item.initials}
              </div>
              <div class="min-w-0">
                <div class="text-sm font-bold text-on-surface truncate">{item.highlightTitle}</div>
                <div class="text-xs text-on-surface-variant truncate">{item.highlightSub}</div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    {/* Eloqwnt Navigation Bar: Progress Track + Prev/Next Buttons */}
    <div class="mt-8 flex items-center justify-between gap-6">
      <div class="flex-1 h-1.5 bg-outline-variant/40 rounded-full overflow-hidden">
        <div
          id="voices-progress-bar"
          class="h-full w-full bg-primary rounded-full origin-left"
          style="transform: scaleX(0.25)"
        ></div>
      </div>

      <div class="flex items-center gap-2.5 shrink-0">
        <button
          type="button"
          id="voices-prev"
          aria-label="Testimonio anterior"
          class="w-11 h-11 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-inverse-surface hover:text-white hover:border-inverse-surface transition-colors cursor-pointer"
        >
          <Icon name="arrow_left" size={18} />
        </button>
        <button
          type="button"
          id="voices-next"
          aria-label="Siguiente testimonio"
          class="w-11 h-11 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:bg-inverse-surface hover:text-white hover:border-inverse-surface transition-colors cursor-pointer"
        >
          <Icon name="arrow_right" size={18} />
        </button>
      </div>
    </div>
  </Container>
</section>

<script>
  import { ensureGsapRegistered } from '../scripts/gsap-setup';

  function initVoicesSlider() {
    const { gsap, Draggable } = ensureGsapRegistered();
    const viewport = document.getElementById('voices-viewport');
    const track = document.getElementById('voices-track');
    const progressBar = document.getElementById('voices-progress-bar');
    const prevBtn = document.getElementById('voices-prev');
    const nextBtn = document.getElementById('voices-next');

    if (!viewport || !track) return;

    const getMaxDrag = () => Math.min(0, viewport.clientWidth - track.scrollWidth);
    const updateProgress = (xVal: number) => {
      if (!progressBar) return;
      const minX = getMaxDrag();
      if (minX >= 0) {
        progressBar.style.transform = 'scaleX(1)';
        return;
      }
      const ratio = gsap.utils.clamp(0.25, 1, gsap.utils.mapRange(0, minX, 0.25, 1, xVal));
      progressBar.style.transform = `scaleX(${ratio.toFixed(3)})`;
    };

    const draggableInstances = Draggable.create(track, {
      type: 'x',
      bounds: { minX: getMaxDrag(), maxX: 0 },
      edgeResistance: 0.72,
      onDrag() {
        updateProgress(this.x);
      },
      onThrowUpdate() {
        updateProgress(this.x);
      },
    });

    const drg = draggableInstances[0];

    const onResize = () => {
      const minX = getMaxDrag();
      drg.applyBounds({ minX, maxX: 0 });
      updateProgress(gsap.getProperty(track, 'x') as number);
    };
    window.addEventListener('resize', onResize);
    const ro = new ResizeObserver(onResize);
    ro.observe(viewport);
    ro.observe(track);

    const stepBy = (dir: number) => {
      const minX = getMaxDrag();
      drg.applyBounds({ minX, maxX: 0 });
      const currentX = (gsap.getProperty(track, 'x') as number) || 0;
      const cardStep = Math.min(440, viewport.clientWidth * 0.85);
      const nextX = gsap.utils.clamp(minX, 0, currentX + dir * cardStep);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      gsap.to(track, {
        x: nextX,
        duration: reduceMotion ? 0 : 0.55,
        ease: 'power3.out',
        onUpdate() {
          updateProgress(gsap.getProperty(track, 'x') as number);
        },
        onComplete() {
          drg?.update();
          updateProgress(gsap.getProperty(track, 'x') as number);
        },
      });
    };

    const onPrev = () => stepBy(1);
    const onNext = () => stepBy(-1);
    prevBtn?.addEventListener('click', onPrev);
    nextBtn?.addEventListener('click', onNext);

    updateProgress(0);

    return () => {
      ro.disconnect();
      window.removeEventListener('resize', onResize);
      prevBtn?.removeEventListener('click', onPrev);
      nextBtn?.removeEventListener('click', onNext);
      drg?.kill();
    };
  }

  let cleanupVoices: (() => void) | undefined;
  const mount = () => {
    cleanupVoices?.();
    cleanupVoices = initVoicesSlider();
  };
  mount();
  document.addEventListener('astro:page-load', mount);
</script>
