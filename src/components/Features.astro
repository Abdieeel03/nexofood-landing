---
import Container from './ui/Container.astro';
import SectionWrapper from './ui/SectionWrapper.astro';
import Icon from './ui/Icon.astro';

interface FeatureCard {
  id: string;
  icon: string;
  tag: string;
  title: string;
  description: string;
  bullets: string[];
  liveMetricLabel: string;
  liveMetricValue: string;
  blueprintTitle: string;
  blueprintSteps: { step: string; detail: string; metric: string }[];
}

const FEATURES: FeatureCard[] = [
  {
    id: 'tienda-online',
    icon: 'storefront',
    tag: '0% COMISIONES',
    title: 'Tienda Online Propia',
    description:
      'Publica tu propio canal de venta digital en minutos. Permite a tus comensales pedir directamente sin intermediarios que te quiten hasta un 30%.',
    bullets: [
      'Checkout ultra rápido y optimizado para móvil',
      'Personalización de colores, logo y dominio propio',
      'Upselling automático de combos y bebidas',
    ],
    liveMetricLabel: 'Conversión en móvil',
    liveMetricValue: '4.8× más rápido',
    blueprintTitle: 'Flujo de Checkout Directo (Sin Registro Forzado)',
    blueprintSteps: [
      { step: '1. Selección inteligente', detail: 'Sugiere bebida y postre según el plato elegido', metric: '+18% ticket' },
      { step: '2. Pago en 1 toque', detail: 'Tarjetas, Yape/Plin, MercadoPago o efectivo', metric: '12 seg prom.' },
      { step: '3. Liquidación directa', detail: 'El dinero entra directo a la cuenta de tu local', metric: '0% comisión' },
    ],
  },
  {
    id: 'kds-multicanal',
    icon: 'point_of_sale',
    tag: 'CENTRALIZADO',
    title: 'Gestor Multicanal (KDS)',
    description:
      'Unifica todos tus canales en una única pantalla de cocina: Rappi, PedidosYa, WhatsApp y tu tienda online marchan en el mismo flujo de producción.',
    bullets: [
      'Pantalla KDS táctil organizada por tiempos de cocción',
      'Comandas impresas automáticamente por estación',
      'Sincronización instantánea de stock de menú',
    ],
    liveMetricLabel: 'Ahorro en despacho',
    liveMetricValue: '-9 min por orden',
    blueprintTitle: 'Sincronización de Estaciones en Tiempo Real',
    blueprintSteps: [
      { step: '1. Ingesta unificada', detail: 'Rappi, PedidosYa y Web entran sin re-digitar en caja', metric: '0 errores' },
      { step: '2. Ruteo por partida', detail: 'Fritura, plancha y barra fría reciben su parte exacta', metric: 'Simultáneo' },
      { step: '3. Alerta de demora', detail: 'Semáforo visual automático si un ticket supera 12 min', metric: 'SLA 99.4%' },
    ],
  },
  {
    id: 'logistica-delivery',
    icon: 'local_shipping',
    tag: 'DESPACHO INTELIGENTE',
    title: 'Logística y Delivery',
    description:
      'Coordina tus propios repartidores o accede a couriers aliados bajo demanda. Mantén al cliente informado en cada segundo del trayecto.',
    bullets: [
      'Tracking en vivo en mapa con enlace vía WhatsApp',
      'Ruteo inteligente para minimizar tiempos de entrega',
      'Métricas exactas de tiempos de preparación y viaje',
    ],
    liveMetricLabel: 'Llamadas de reclamo',
    liveMetricValue: '-82% en salón',
    blueprintTitle: 'Despacho Híbrido (Flota Propia + Couriers Aliados)',
    blueprintSteps: [
      { step: '1. Asignación automática', detail: 'Prioriza tus motorizados propios; si hay pico, llama flota externa', metric: 'Óptimo' },
      { step: '2. Agrupación por zona', detail: 'Combina hasta 3 pedidos cercanos en una sola salida', metric: '-34% costo km' },
      { step: '3. Enlace vivo WhatsApp', detail: 'El comensal ve al repartidor en el mapa sin bajar ninguna app', metric: '4.9★ satisfacción' },
    ],
  },
  {
    id: 'fidelizacion-crm',
    icon: 'loyalty',
    tag: 'RETENCIÓN +30%',
    title: 'Fidelización y Base de Clientes',
    description:
      'Los clientes que te piden en apps no son tuyos. Con Nexofood construyes tu propia base de datos para volver a venderles con promociones personalizadas.',
    bullets: [
      'Base de datos de comensales 100% propia',
      'Campañas automatizadas por WhatsApp y correo',
      'Sistema de puntos y recompensas recurrentes',
    ],
    liveMetricLabel: 'Tasa de recompra',
    liveMetricValue: '+35% al mes',
    blueprintTitle: 'Motor de Retención Automática para Comensales',
    blueprintSteps: [
      { step: '1. Captura automática', detail: 'Cada pedido guarda nombre, plato favorito y frecuencia', metric: '100% tuyo' },
      { step: '2. Reactivación a los 14 días', detail: 'Envía cupón por WhatsApp si un cliente habitual no vuelve', metric: '24% conversión' },
      { step: '3. Cashback gastronómico', detail: 'Puntos canjeables solo en tu tienda directa para blindar margen', metric: 'LTV 2.6×' },
    ],
  },
];
---

<SectionWrapper background="default" padding="lg" id="productos">
  <Container>
    {/* Section Header: Mobile-first */}
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-10 md:mb-14">
      <div class="max-w-[38rem]">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-on-surface tracking-tight leading-tight">
          Todo lo que necesitas para escalar tu gastronomía
        </h2>
        <p class="mt-2.5 sm:mt-3 text-sm sm:text-base md:text-lg text-on-surface-variant leading-relaxed">
          Módulos integrados creados específicamente para eliminar los cuellos
          de botella reales en cocina, delivery y rentabilidad.
        </p>
      </div>
      <p class="text-xs sm:text-sm font-semibold text-primary bg-surface-container-low px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl shadow-[var(--shadow-border)] w-full sm:w-auto lg:self-end">
        Toca o haz clic en cualquier módulo para ver su flujo operativo
      </p>
    </div>

    {/* Mobile-first 1-col -> md:2-col Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-6 md:gap-7 items-start">
      {FEATURES.map((feature) => (
        <article
          data-feature-card
          data-open="false"
          class="t-acc t-resize group bg-surface-container-lowest rounded-2xl sm:rounded-3xl p-5 sm:p-7 shadow-[var(--shadow-border)] hover:shadow-[var(--shadow-border-hover)] flex flex-col relative overflow-hidden"
        >
          {/* Card Top Bar: responsive wrapping on mobile */}
          <div class="flex flex-wrap items-center justify-between gap-2.5 mb-3.5 sm:mb-4">
            <div class="w-11 h-11 sm:w-12 sm:h-12 rounded-xl sm:rounded-2xl bg-surface-container text-primary flex items-center justify-center shrink-0 transition-[background-color,color] duration-200 group-hover:bg-primary group-hover:text-on-primary">
              <Icon name={feature.icon} size={24} />
            </div>
            <div class="flex flex-wrap items-center justify-end gap-1.5 sm:gap-2">
              <span class="text-[11px] font-bold tracking-tight sm:tracking-wider py-1 px-2.5 rounded-full bg-surface-container-low text-on-surface-variant tabular-nums">
                {feature.liveMetricLabel}: <strong class="text-primary">{feature.liveMetricValue}</strong>
              </span>
              <span class="text-[11px] font-extrabold tracking-wider py-1 px-2.5 rounded-full bg-tangerine-subtle text-secondary">
                {feature.tag}
              </span>
            </div>
          </div>

          {/* Title & Description: natural height on mobile, equalized 3-line min-h on md+ */}
          <div class="flex flex-col gap-1.5 sm:gap-2 mb-3.5 sm:mb-4">
            <h3 class="text-lg sm:text-2xl font-extrabold text-on-surface tracking-tight">
              {feature.title}
            </h3>
            <p class="text-sm sm:text-base text-on-surface-variant leading-relaxed md:min-h-[4.5rem]">
              {feature.description}
            </p>
          </div>

          {/* Core Bullets */}
          <ul class="flex flex-col gap-2.5 pt-3.5 sm:pt-4 border-t border-surface-container">
            {feature.bullets.map((bullet) => (
              <li class="flex items-start sm:items-center gap-2.5 text-xs sm:text-sm text-on-surface font-semibold">
                <span class="text-primary-container flex shrink-0 mt-0.5 sm:mt-0">
                  <Icon name="check_circle" size={17} fill={true} />
                </span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>

          {/* Expandable Operational Blueprint (0fr when closed) */}
          <div class="t-acc-panel">
            <div class="t-acc-panel-inner">
              <div class="mt-4 p-3.5 sm:p-4 rounded-xl sm:rounded-2xl bg-surface-container-low/85 border border-outline-variant/40 flex flex-col gap-2.5 sm:gap-3">
                <div class="flex flex-wrap items-center justify-between gap-1.5">
                  <span class="text-xs font-extrabold text-primary uppercase tracking-wider">
                    {feature.blueprintTitle}
                  </span>
                  <span class="text-[11px] font-semibold text-on-surface-variant tabular-nums">
                    Tiempo real
                  </span>
                </div>
                <div class="flex flex-col gap-2">
                  {feature.blueprintSteps.map((item) => (
                    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-1.5 sm:gap-3 p-2.5 rounded-xl bg-surface-container-lowest shadow-[0_1px_2px_oklch(0_0_0/0.04)]">
                      <div class="flex flex-col">
                        <span class="text-xs font-bold text-on-surface">
                          {item.step}
                        </span>
                        <span class="text-xs text-on-surface-variant">
                          {item.detail}
                        </span>
                      </div>
                      <span class="self-start sm:self-auto text-[11px] font-extrabold text-primary bg-mint-subtle px-2 py-0.5 rounded-md shrink-0 tabular-nums">
                        {item.metric}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>

          {/* Full-width Thumb-friendly Trigger Footer (min-h 44px) */}
          <div class="pt-3 mt-3.5 sm:pt-4 sm:mt-4 border-t border-surface-container">
            <button
              type="button"
              data-feature-toggle
              aria-expanded="false"
              class="t-learn t-acc-head w-full min-h-[44px] px-2.5 py-2 -mx-2.5 w-[calc(100%+1.25rem)] rounded-xl flex items-center justify-between gap-2 text-xs sm:text-sm font-bold text-primary hover:text-[#004e34] hover:bg-surface-container-low/70 active:bg-surface-container cursor-pointer transition-[color,background-color,transform] duration-150 ease-out active:scale-[0.98]"
            >
              <span class="inline-flex items-center gap-1.5">
                <span data-feature-toggle-text>
                  Ver flujo operativo en vivo
                </span>
                <span class="t-learn-chevron w-4 h-4">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                    <path class="t-learn-arm t-learn-arm-top" d="M6 4L10 8"></path>
                    <path class="t-learn-arm t-learn-arm-bot" d="M10 8L6 12"></path>
                  </svg>
                </span>
              </span>

              <span class="t-acc-chevron w-5 h-5 text-on-surface-variant/75 pointer-events-none shrink-0">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                  <path d="M4 6.5L8 10.5L12 6.5"></path>
                </svg>
              </span>
            </button>
          </div>
        </article>
      ))}
    </div>
  </Container>
</SectionWrapper>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initFeatures() {
    const cards = document.querySelectorAll<HTMLElement>('[data-feature-card]');
    cards.forEach((card) => {
      const btn = card.querySelector<HTMLButtonElement>('[data-feature-toggle]');
      const label = card.querySelector<HTMLElement>('[data-feature-toggle-text]');
      if (!btn || !label) return;

      btn.addEventListener('click', () => {
        const isOpen = card.getAttribute('data-open') === 'true';
        const nextState = !isOpen;
        card.setAttribute('data-open', String(nextState));
        btn.setAttribute('aria-expanded', String(nextState));
        label.textContent = nextState
          ? 'Ocultar flujo operativo'
          : 'Ver flujo operativo en vivo';
      });
    });

    const mm = gsap.matchMedia();
    mm.add(
      {
        canAnimate: '(prefers-reduced-motion: no-preference)',
      },
      (context) => {
        if (!context.conditions?.canAnimate) return;

        ScrollTrigger.batch('[data-feature-card]', {
          start: 'top 88%',
          once: true,
          onEnter: (batch) => {
            gsap.from(batch, {
              y: 20,
              autoAlpha: 0,
              duration: 0.55,
              stagger: 0.1,
              ease: 'power2.out',
              clearProps: 'transform,opacity,visibility',
            });
          },
        });
      }
    );
  }

  initFeatures();
  document.addEventListener('astro:page-load', initFeatures);
</script>
