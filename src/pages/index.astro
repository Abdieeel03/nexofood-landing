---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import HeroStage from '../components/HeroStage.astro';
import PerceptionGap from '../components/PerceptionGap.astro';
import SelectedKitchens from '../components/SelectedKitchens.astro';
import CapabilitiesMatrix from '../components/CapabilitiesMatrix.astro';
import Pricing from '../components/Pricing.astro';
import VoicesDragSlider from '../components/VoicesDragSlider.astro';
import ConversionStage from '../components/ConversionStage.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main class="grow">
    <HeroStage />
    <PerceptionGap />
    <SelectedKitchens />
    <CapabilitiesMatrix />
    <Pricing />
    <VoicesDragSlider />
    <ConversionStage />
  </main>
  <Footer />
</Layout>
