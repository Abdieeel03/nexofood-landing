---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nexofood — Potencia tu negocio gastronómico',
  description = 'La plataforma #1 para restaurantes. Crea tu tienda online, gestiona pedidos de todas las plataformas y fideliza a tus clientes sin comisiones abusivas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Nexofood, restaurante, pedidos online, delivery, gastronomía, software gastronómico, POS gastronómico"
    />
    <meta name="author" content="Nexofood" />

    {/* Preconnect & Editorial Typography (Bricolage Grotesque + Instrument Serif + JetBrains Mono) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-[100dvh] flex flex-col bg-background text-on-background">
    <slot />

    <script>
      import { ensureGsapRegistered } from '../scripts/gsap-setup';

      function initGlobalMotion() {
        const { gsap, ScrollTrigger } = ensureGsapRegistered();

        // Smooth Anchor Scrolling via ScrollToPlugin
        const anchorLinks = document.querySelectorAll<HTMLAnchorElement>('a[href^="/#"], a[href^="#"]');
        const onAnchorClick = (e: MouseEvent) => {
          const anchor = e.currentTarget as HTMLAnchorElement;
          const href = anchor.getAttribute('href') || '';
          const hashIdx = href.indexOf('#');
          if (hashIdx === -1) return;
          const hash = href.slice(hashIdx);
          if (hash.length <= 1) return;

          const isSamePage =
            href.startsWith('#') ||
            (href.startsWith('/#') && window.location.pathname === '/');

          if (!isSamePage) return;

          const target = document.querySelector(hash);
          if (!target) return;

          e.preventDefault();
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduceMotion) {
            target.scrollIntoView({ behavior: 'auto' });
          } else {
            gsap.to(window, {
              duration: 0.9,
              ease: 'power3.inOut',
              scrollTo: { y: target, offsetY: 76 },
            });
          }
        };

        anchorLinks.forEach((a) => a.addEventListener('click', onAnchorClick));

        // Ensure ScrollTrigger positions recalculate cleanly after fonts finish loading
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => {
            ScrollTrigger.refresh();
          });
        }

        return () => {
          anchorLinks.forEach((a) => a.removeEventListener('click', onAnchorClick));
        };
      }

      let cleanupGlobal: (() => void) | undefined;
      const mount = () => {
        cleanupGlobal?.();
        cleanupGlobal = initGlobalMotion();
      };
      mount();
      document.addEventListener('astro:page-load', mount);
    </script>
  </body>
</html>
